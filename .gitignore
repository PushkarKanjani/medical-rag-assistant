# Python bytecode and caches
__pycache__/
*.py[cod]
*$py.class

# Python tooling caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.pyre/
.hypothesis/

# Virtual environments
.venv/
venv/
ENV/

# Test and coverage outputs
.coverage
.coverage.*
htmlcov/

# Notebooks and editor caches
*.ipynb
.ipynb_checkpoints/
.vscode/
.continue/
.idea/

# Environment variables & secrets
.env
.env.*
.env.local

# Logs
*.log

# Local data & indexes (large binaries / vector stores)
data/indexes/
data/extracted/
data/pdf/*.pdf
qdrant_db/
qdrant_db_text/
*.pkl
